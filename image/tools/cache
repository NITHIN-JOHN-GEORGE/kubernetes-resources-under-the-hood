#!/bin/sh
# cache --mib 192 [--loop]
# Writes a file of that size in 16 MiB steps (fsync after each, so dirty pages never pile up),
# then reads it back twice. The data ends up in the page cache: it counts as `file`, not `anon`.
# With --loop it keeps rereading forever, so the kernel keeps reclaiming cache.
mib=192; loop=0
while [ $# -gt 0 ]; do case "$1" in --mib) mib="$2"; shift 2;; --loop) loop=1; shift;; *) echo "usage: cache --mib N [--loop]"; exit 1;; esac; done
steps=$(( (mib + 15) / 16 ))
i=0
while [ "$i" -lt "$steps" ]; do
  dd if=/dev/zero of=/tmp/cache-file bs=1M count=16 seek=$((i*16)) conv=notrunc,fsync 2>/dev/null
  i=$((i+1))
done
cat /tmp/cache-file > /dev/null; cat /tmp/cache-file > /dev/null
echo "cache: wrote and read ${mib} MiB"
if [ "$loop" = 1 ]; then while :; do cat /tmp/cache-file > /dev/null; done; fi
