#!/bin/sh
# forkmany --n 100   Try to start N background processes, then keep running.
# The spawner runs in a subshell: if the kernel refuses a fork, only that subshell stops.
n=100
while [ $# -gt 0 ]; do case "$1" in --n) n="$2"; shift 2;; *) echo "usage: forkmany --n N"; exit 1;; esac; done
( i=0
  while [ "$i" -lt "$n" ]; do
    sleep 3600 &
    i=$((i+1))
  done
  echo "forkmany: started all $n" )
echo "forkmany: spawner finished"
exec sleep infinity
